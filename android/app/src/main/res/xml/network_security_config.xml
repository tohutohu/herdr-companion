<?xml version="1.0" encoding="utf-8"?>
<!-- The gateway is reached over Tailscale (WireGuard-encrypted), usually as
     plain HTTP on a tailnet hostname or 100.x address. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
